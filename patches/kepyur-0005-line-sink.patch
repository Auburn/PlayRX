+// kepyur: analog FPV video decoder (FM composite -> 8-bit grey frames). Shared by the app and the desktop
+// tools. Grown from vtx-spike/viewer/vtxview.cpp.
+//
+//   FrontEnd fe(fs_in, shift_hz, on_frame);   // fs_in 40e6 (halfband to 20 MS/s) or 20e6
+//   for (each IQ sample) fe.feed(x);
+//
+// Single-threaded: feed() and every callback run on the caller's thread.
+#pragma once
+#include <complex>
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace kp {
+
+using cf = std::complex<float>;
+
+struct VideoStd {
+  double T_us;   // line period
+  double a0_us;  // active video start after the hsync leading edge
+  double aw_us;  // active video width
+  int active;    // active lines per field
+  int skip;      // lines from the field's first broad pulse to the first active line
+  const char *name;
+};
+extern const VideoStd kNtsc, kPal;
+
+// A finished picture, 4 bytes per pixel (R, G, B, 0xff). Valid only during the callback.
+struct Frame {
+  const uint8_t *data;
+  int width, height;  // 720 x 480 (NTSC) / 720 x 576 (PAL)
+  const VideoStd *std;
+};
+using FrameSink = std::function<void(const Frame &)>;
+
+// AnalogRX low latency: one picture line, handed out the moment the decoder has drawn it (about a line after it
+// arrived) instead of at the end of its field. 4 bytes per pixel (R, G, B, 0xff); valid only during the callback.
+// row: the line within its field (0 .. active-1); field 0 is the lower field (frame lines 2*row + 1), field 1 the
+// upper (2*row). A line patched again later (sparkle repair) is handed out again.
+struct Line {
+  const uint8_t *data;
+  int width, row, field, active;
+  const VideoStd *std;
+  double t_s = 0;  // when the newest samples of the line arrived (steady clock, s): set by the caller of decode(), 0 = unknown
+};
+using LineSink = std::function<void(const Line &)>;
+
+struct DecoderStats {
+  bool acquiring = true;
+  float sign = 1, tip = 0, blank = 0;     // levels in MHz of discriminator output
+  uint64_t lines = 0, lines_locked = 0;   // since the last acquisition
+  uint64_t fields = 0, frames = 0;        // since construction
+  uint64_t acquisitions = 0, losses = 0;  // successful acquisitions, lock losses
+  uint64_t rephases = 0;                  // line grid moved onto a jumped signal without re-acquiring
+  // AnalogRX sparkle repair (set_repair): FM clicks patched over, and badly hit lines kept from the last field
+  uint64_t clicks_repaired = 0, lines_kept = 0;
+  double line_us = 0;                     // tracked line period
+  float lock_recent = 0;                  // locked fraction over the last ~2 fields
+  bool colour = false;                    // colour is being decoded (burst present and steady)
+  float burst_err = 0;                    // mean burst phase error (rad)
+  const char *std_name = "?";
+};
+
+struct DecoderOpts {
+  int width = 720;
+  bool fields = true;          // true: every field, line-doubled (60/50 Hz, no combing); false: woven frames
+  int std_force = 0;           // 0 auto, 1 NTSC, 2 PAL
+  bool force_invert = false;   // only try sync at the high-frequency end
+  bool colour = true;          // decode colour (falls back to grey when there is no usable burst)
+  // AnalogRX: how colour is kept out of the picture's brightness (NTSC; PAL always uses the notch).
+  //  0 = classic: 3 MHz 4th-order low-pass + a notch at the subcarrier (rings ~4 px after every edge)
+  //  1 = comb: a gentle 4.8 MHz low-pass, colour cancelled with the line before (no ringing, sharper)
+  // -1 = from the environment, ARX_LUMA=classic|comb (default comb)
+  int luma_filter = -1;
+  LineSink lines;  // AnalogRX low latency: every line as it is drawn (on the decoding thread); empty = none
+};
+
+class Decoder;
+
+// AnalogRX: sparkle repair, for every decoder in the process (takes effect at once). The white / black
+// sparkles of a weak signal are FM "clicks": the carrier's envelope collapses and its phase slips a turn. The
+// front end marks those instants; the decoder, which draws each line about a line after it arrives, patches the
+// picture over each mark (a straight line between the good points either side; sync is left alone) and redraws
+// a badly hit line from the lines above and below it. Nothing is held back: no delay is added.
+void set_repair(bool on);
+bool repair_on();
+
+// AnalogRX: adaptive comb (NTSC comb mode), for every decoder in the process. The comb separates colour from
+// brightness by comparing each line with the one before; where that line is clearly different (OSD text,
+// horizons) it leaves a halo and false colour. There the brightness falls back to the notch filter and the
+// colour is faded out. Uses only the line before: no delay is added.
+void set_adaptive_comb(bool on);
+bool adaptive_comb_on();
+
+// AnalogRX: smooth lines (DecoderOpts::fields), for every decoder in the process. A field is every other line of
+// the picture; it used to be shown with each line twice (stair-stepped edges, and the two fields half a line
+// apart, so the picture shimmered up and down). On: each field's lines go in their own place and the lines
+// between are interpolated along edges (edge-based line averaging). Done as each field ends: no delay.
+void set_smooth_lines(bool on);
+bool smooth_lines_on();
+
+// IQ (at fs_in) -> DC removal -> NCO -> [halfband /2 when fs_in >= 40e6] -> FM discriminator -> Decoder.
+class FrontEnd {
+public:
+  FrontEnd(double fs_in, double shift_hz, FrameSink sink, const DecoderOpts &o = {});
+  ~FrontEnd();
+  void set_shift(double shift_hz);  // carrier offset from the stream centre (Hz) to bring to 0
+  double shift() const { return _shift; }
+  void feed(const cf *x, size_t n);  // demod + decode
+  // The two halves, for running them on two threads: demod() -> discriminator output (MHz at fs_demod),
+  // decode() -> frames. Each half is single-threaded.
+  // bad (optional, sparkle repair): per output sample, 1 = the carrier's envelope collapsed there (a click)
+  void demod(const cf *x, size_t n, std::vector<float> &out, std::vector<uint8_t> *bad = nullptr);
+  void decode(const float *d, size_t n, const uint8_t *bad = nullptr);
+  DecoderStats stats() const;
+  double fs_demod() const { return _fs_out; }
+  // AnalogRX async frames: true = whole pictures are built and handed to the FrameSink on a thread of their own,
+  // so the decoding thread goes straight on with the next lines (low latency). Call on the decoding thread.
+  void set_async_frames(bool on);
+
+private:
+  double _fs_in, _fs_out, _shift = 0;
+  bool _decimate;
+  static constexpr int kHb = 23;   // halfband taps
+  static constexpr int kTab = 4096;  // mixer table / chunk length
+  float _h[kHb];
+  std::vector<float> _tr, _ti;     // step^i, i < kTab
+  cf _stepN{1, 0}, _rot{1, 0}, _dc{}, _prev{1, 0};
+  std::vector<float> _wr, _wi;     // mixed samples with kHb-1 of history in front
+  std::vector<float> _yr, _yi;     // decimated
+  int _phase = 0;                  // start of the next halfband window in the next chunk (0 or 1)
+  std::vector<float> _dbuf;
+  Decoder *_dec;
+  std::vector<float> _env;  // sparkle repair: each output sample's envelope (power)
+  float _pref = 0;          // ... and its recent level
+};
+
+}  // namespace kp
