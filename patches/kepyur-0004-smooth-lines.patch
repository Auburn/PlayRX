+  // AnalogRX smooth lines: field f (the upper field when upper) into the frame at its own lines, the lines
+  // between from the field lines above (p) and below (q), averaged along whichever of 5 directions matches best
+  // (so a diagonal edge stays a clean diagonal instead of a staircase)
+  void emit_field(const std::vector<uint8_t> &f, bool upper) {
+    const int W = o.width, A = std_->active;
+    const size_t rowb = static_cast<size_t>(W) * 4;
+    uint8_t *out = frame.data();
+    for (int r = 0; r < A; r++) std::memcpy(out + (2 * r + (upper ? 0 : 1)) * rowb, f.data() + r * rowb, rowb);
+    auto lum = [](const uint8_t *px) { return px[0] + 2 * px[1] + px[2]; };
+    for (int r = 0; r < A; r++) {
+      const int line = upper ? 2 * r + 1 : 2 * r;
+      const int rp = upper ? r : std::max(r - 1, 0), rq = upper ? std::min(r + 1, A - 1) : r;
+      const uint8_t *p = f.data() + rp * rowb, *q = f.data() + rq * rowb;
+      uint8_t *dst = out + line * rowb;
+      for (int x = 0; x < W; x++) {
+        int best = 0, bc = 1 << 30;
+        for (int d = -2; d <= 2; d++) {
+          const int xp = x + d, xq = x - d;
+          if (xp < 0 || xp >= W || xq < 0 || xq >= W) continue;
+          const int c = std::abs(lum(p + xp * 4) - lum(q + xq * 4)) + (d ? 24 + 8 * std::abs(d) : 0);  // prefer straight down
+          if (c < bc) bc = c, best = d;
+        }
+        const uint8_t *a = p + (x + best) * 4, *b = q + (x - best) * 4;
+        for (int k = 0; k < 4; k++) dst[x * 4 + k] = static_cast<uint8_t>((a[k] + b[k] + 1) >> 1);
+      }
+    }
+    frames_out++;
+    if (sink) sink(Frame{frame.data(), o.width, 2 * std_->active, std_});
+  }
